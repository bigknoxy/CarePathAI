# Environment variables for CarePathAI
# Copy this file to .env and update with your actual values

# Database password for PostgreSQL
DB_PASSWORD=changeme

# User and group IDs for Docker container permissions
UID=<your-uid>
GID=<your-gid>

# Data directory for ML service
CAREPATH_DATA_DIR=/app/data

# Cache directories for ML models
TRANSFORMERS_CACHE=/cache
HF_HOME=/cache